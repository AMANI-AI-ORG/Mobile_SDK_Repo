{
  "name": "AmaniUI",
  "version": "1.4.9-alpha10-test",
  "license": {
    "type": "Copyright",
    "text": "Copyright 2026\nAmani Ai AŞ."
  },
  "swift_versions": "5.0",
  "requires_arc": true,
  "homepage": "http://www.amani.ai/",
  "authors": {
    "Amani Ai": "admin@amani.ai"
  },
  "summary": "Amani UI SDK",
  "description": "The Amani Software Development Kit UI package.",
  "source": {
    "git": "https://github.com/AMANI-AI-ORG/IOS.SDK.UI.git",
    "tag": "1.4.9-alpha10-test"
  },
  "documentation_url": "https://documentation.amani.ai",
  "platforms": {
    "ios": "13.0"
  },
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -weak_framework CryptoKit -weak_framework CoreNFC -weak_framework CryptoTokenKit"
  },
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/AmaniUI/**/*.{h,m,swift}",
      "exclude_files": [
        "Sources/AmaniUI/SpeechVerifierIntegration/**/*",
        "AmaniUnitTests/**/*",
        "AmaniUI.xcodeproj/**/*"
      ],
      "resource_bundles": {
        "AmaniUI": [
          "Sources/AmaniUI/**/*.{xib,storyboard,xcassets,xcprivacy}"
        ]
      },
      "dependencies": {
        "lottie-ios": [
          "~> 4.5.0"
        ],
        "AmaniSDK": [
          "~> 3.7.9"
        ]
      }
    },
    {
      "name": "SpeechVerifier",
      "dependencies": {
        "AmaniUI/Core": [],
        "AmaniSpeechVerifier": [
          "~> 1.0"
        ]
      },
      "source_files": "Sources/AmaniUI/SpeechVerifierIntegration/**/*.swift",
      "pod_target_xcconfig": {
        "OTHER_SWIFT_FLAGS": "$(inherited) -D AMANI_SPEECH_VERIFIER_ENABLED"
      }
    }
  ],
  "swift_version": "5.0"
}
